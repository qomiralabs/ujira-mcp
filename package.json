{
  "name": "@ujira/mcp",
  "version": "0.2.0",
  "description": "Mandate bound payouts on Stellar: a payout engine and an MCP server that pay only inside the limits a principal set on chain.",
  "keywords": [
    "mcp",
    "stellar",
    "soroban",
    "payouts",
    "usdc"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qomiralabs/ujira-mcp.git"
  },
  "homepage": "https://github.com/qomiralabs/ujira-mcp#readme",
  "bugs": {
    "url": "https://github.com/qomiralabs/ujira-mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ujira-mcp": "dist/mcp/main.js",
    "ujira-mcp-http": "dist/mcp/http-main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "demo": "tsx examples/demo.ts",
    "start:http": "node dist/mcp/http-main.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@stellar/stellar-sdk": "17.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
